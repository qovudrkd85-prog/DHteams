# Supabase 프로젝트의 Connect 창에서 복사 (공개 키만 사용)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# 서버는 위 값을 기본으로 사용합니다. 필요할 때만 별도로 설정하세요.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# TEAM_PASSWORD, SESSION_SECRET, NEXT_PUBLIC_SECURE_MODE는 더 이상 사용하지 않습니다.
# schema-accounts.sql 적용 및 Auth의 Confirm Email 끄기: supabase/README.md 참고
